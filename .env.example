# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase
# (Dashboard Supabase > Project Settings > API).
# Ne jamais committer .env.local.

# URL du projet Supabase, ex : https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique (publishable, sb_publishable_... ou ancienne clé "anon").
# Elle est exposée au navigateur : la sécurité repose sur le RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (sb_secret_... ou ancienne clé "service_role") : contourne le RLS.
# Utilisée uniquement côté serveur (création des comptes dans /admin/utilisateurs, scripts de test).
# Ne JAMAIS la préfixer par NEXT_PUBLIC_ ni l'importer dans un composant client.
SUPABASE_SERVICE_ROLE_KEY=
